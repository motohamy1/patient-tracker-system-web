{
  "name": "patient-clinical-workspace",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/generate-tokens.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/generate-tokens.mjs && node scripts/check-design-tokens.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "node scripts/check-design-tokens.mjs",
    "tokens:generate": "node scripts/generate-tokens.mjs --check",
    "tokens:check": "node scripts/generate-tokens.mjs --check",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:visual": "playwright test --config=playwright.config.ts"
  },
  "_comment": "D-05/D-13: 'lint' and 'prebuild' invoke scripts/check-design-tokens.mjs directly — this token check is LOAD-BEARING, not scaffolding. It must be APPENDED TO, never replaced by, any future ESLint, Biome or Prettier pass (02-RESEARCH.md Pitfall 4).",
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "@tailwindcss/postcss": "4.3.3",
    "d3-axis": "^3.0.0",
    "d3-brush": "^3.0.0",
    "d3-quadtree": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-time": "^3.1.0",
    "d3-zoom": "^3.0.0",
    "gsap": "3.15.0",
    "lucide-react": "1.52.0",
    "motion": "14.0.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/d3-axis": "^3.0.6",
    "@types/d3-brush": "^3.0.6",
    "@types/d3-quadtree": "^3.0.6",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-time": "^3.0.4",
    "@types/d3-zoom": "^3.0.9",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "typescript": "~5.9",
    "vitest": "5.0.3"
  }
}
